<Window x:Class="AnyDictation.App.StatusWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AnyDictation.App"
        Title="Any Dictation 状態" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" UseLayoutRounding="True"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style x:Key="ToastButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>
    <!-- 外側の余白は影を描くため。位置は Reposition で補正する -->
    <Grid x:Name="ShadowArea" Margin="20,12,20,32">
        <Border x:Name="Card" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                CornerRadius="12" Padding="16,12,10,12" MinWidth="320" MaxWidth="560" MinHeight="52">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 状態のインジケーター。1行目の文字の高さにそろえる -->
                <Grid x:Name="Indicator" Width="16" Height="18" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{StaticResource Recording}" Visibility="Collapsed"/>
                    <ui:ProgressRing x:Name="Spinner" Width="14" Height="14" IsIndeterminate="True" Visibility="Collapsed"
                                     Foreground="{DynamicResource Accent}"/>
                    <Grid x:Name="Badge" Width="16" Height="16" Visibility="Collapsed">
                        <Ellipse x:Name="BadgeCircle"/>
                        <TextBlock x:Name="BadgeGlyph" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailText" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="CostText" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="InputLevelText" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <local:LevelMeter x:Name="InputLevelBar" Grid.Column="2" Height="18" Margin="12,0,0,0" VerticalAlignment="Center"
                                  BarCount="14" BarWidth="3" Gap="2" BarBrush="{StaticResource Recording}" Visibility="Collapsed"/>

                <StackPanel x:Name="Buttons" Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                    <ui:Button x:Name="CancelButton" Content="取消" Style="{StaticResource ToastButton}" Click="OnCancel"/>
                    <ui:Button x:Name="AbortButton" Content="中止" Style="{StaticResource ToastButton}" Click="OnAbort"/>
                    <ui:Button x:Name="RetryButton" Content="再送" Style="{StaticResource ToastButton}" Click="OnRetry"
                               Appearance="Primary" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                               BorderBrush="Transparent" FontWeight="SemiBold"/>
                    <ui:Button x:Name="DiscardButton" Content="破棄" Style="{StaticResource ToastButton}" Click="OnDiscard"/>
                    <ui:Button x:Name="CloseButton" Content="閉じる" Style="{StaticResource ToastButton}" Click="OnClose"/>
                </StackPanel>

                <!-- Live の途中経過。最大 3 行で、超えたら最新の行を見せる -->
                <ScrollViewer x:Name="LiveScroll" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,2"
                              MaxHeight="75" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Visibility="Collapsed">
                    <TextBlock x:Name="LiveText" FontSize="15" LineHeight="24.75" LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"
                               AutomationProperties.LiveSetting="Off"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
