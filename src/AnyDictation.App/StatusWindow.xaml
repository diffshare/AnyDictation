<Window x:Class="AnyDictation.App.StatusWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Any Dictation 状態" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" UseLayoutRounding="True">
    <Border Background="#F0202428" CornerRadius="10" Padding="14,10" BorderBrush="#40FFFFFF" BorderThickness="1">
        <StackPanel MinWidth="260" MaxWidth="360">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Fill="Gray"/>
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="DetailText" Foreground="#FFD0D4D8" FontSize="12" TextWrapping="Wrap" Margin="22,4,0,0"/>
            <TextBlock x:Name="LiveText" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="22,6,0,0" MaxHeight="96" Visibility="Collapsed"/>
            <TextBlock x:Name="CostText" Foreground="#FFB8D8EF" FontSize="12" TextWrapping="Wrap" Margin="22,6,0,0" Visibility="Collapsed"/>
            <StackPanel x:Name="InputMeter" Visibility="Collapsed" Margin="22,8,0,0">
                <ProgressBar x:Name="InputLevelBar" Height="8" Minimum="0" Maximum="100"
                             Background="#FF444A50" Foreground="#FF66BB6A" BorderThickness="0"
                             AutomationProperties.Name="マイク入力レベル"/>
                <TextBlock x:Name="InputLevelText" Foreground="#FFD0D4D8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="Buttons" Orientation="Horizontal" Margin="22,8,0,0">
                <Button x:Name="CancelButton" Content="取消" Focusable="False" Padding="12,3" Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="AbortButton" Content="中止" Focusable="False" Padding="12,3" Margin="0,0,8,0" Click="OnAbort"/>
                <Button x:Name="RetryButton" Content="再送" Focusable="False" Padding="12,3" Margin="0,0,8,0" Click="OnRetry"/>
                <Button x:Name="DiscardButton" Content="破棄" Focusable="False" Padding="12,3" Margin="0,0,8,0" Click="OnDiscard"/>
                <Button x:Name="CloseButton" Content="閉じる" Focusable="False" Padding="12,3" Click="OnClose"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
