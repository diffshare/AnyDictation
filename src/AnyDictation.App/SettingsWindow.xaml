<ui:FluentWindow x:Class="AnyDictation.App.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AnyDictation.App"
        Title="Any Dictation 設定" Width="780" Height="556" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="ErrorBanner" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ErrorBannerBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- 結果やエラーを出すときだけ場所を取る -->
        <Style x:Key="OptionalNote" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 入力欄の直下に出すエラー。ラベル列の幅だけ字下げする -->
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource OptionalNote}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorText}"/>
            <Setter Property="Margin" Value="122,-4,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- ラベル列 110px + 列間 12px の 2 列の行 -->
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左ナビ。TabControl を左に置き、WPF UI の NavigationView に寄せた見た目にする -->
        <Style x:Key="NavTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel IsItemsHost="True" Margin="8,4,8,0" KeyboardNavigation.TabNavigation="Once"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="8,14,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" Height="36" CornerRadius="6" Margin="0,0,0,2" Background="Transparent">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16" Margin="0,0,12,0"/>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavSelectedBg}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 枠とスクロールを持たない一覧。外側のページがスクロールする -->
        <ControlTemplate x:Key="PlainList" TargetType="ListBox">
            <ItemsPresenter/>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Any Dictation 設定" Height="36" ShowMaximize="False"/>

        <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource NavTabs}" ItemContainerStyle="{StaticResource NavItem}">
            <!-- ======== プロファイル ======== -->
            <TabItem x:Name="ProfileTab" Header="プロファイル" Tag="{x:Static ui:SymbolRegular.PersonVoice24}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,14">
                        <TextBlock Style="{StaticResource PageTitle}" Text="プロファイル"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,2,0,12" Text="一覧で選ぶと下で編集できます。変更はすぐに保存されます。"/>
                        <Border x:Name="SettingsCorruptBanner" Style="{StaticResource ErrorBanner}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="SettingsCorruptText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorText}"/>
                                <ui:Button Content="破損ファイルを別名へ退避して初期化" Appearance="Secondary" Margin="0,8,0,0" Click="OnQuarantineSettings"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="ProfileList" Template="{StaticResource PlainList}" SelectionChanged="OnProfileSelected"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Stroke}"
                                                        BorderThickness="1" CornerRadius="8" Padding="16,11" Margin="0,0,0,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StrokeStrong}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ProfileRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="20" CornerRadius="10" Padding="8,0" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource BadgeBg}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="使用中" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeFg}" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="入力が必要" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningText}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding NeedsInput, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource Card}">
                            <!-- 入力欄は抜けたとき(または Enter)に保存する -->
                            <StackPanel x:Name="Form" IsEnabled="False" LostKeyboardFocus="OnFormFocusLeft" PreviewKeyDown="OnFormKeyDown">
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="名前"/>
                                    <TextBox x:Name="NameBox" Grid.Column="1"/>
                                </Grid>
                                <TextBlock x:Name="NameError" Style="{StaticResource FieldError}"/>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="サービス"/>
                                    <ComboBox x:Name="ProviderBox" Grid.Column="1" SelectionChanged="OnProviderChanged"/>
                                </Grid>
                                <TextBlock x:Name="LiveNote" Visibility="Collapsed" Style="{StaticResource Note}" Foreground="{DynamicResource WarningText}" Margin="122,0,0,10"
                                           Text="Live は録音中から音声を送信し、途中の文字を状態表示に出します。取消・中止・失敗の前に送信済みの音声は取り消せません。失敗後の再送は全体を送り直すため追加課金されます。音声は 24 kHz で録音します。"/>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="エンドポイント"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="EndpointBox" TextChanged="OnEndpointEdited"/>
                                        <TextBlock x:Name="EndpointPlaceholder" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondary}"
                                                   Margin="11,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="EndpointError" Style="{StaticResource FieldError}"/>
                                <TextBlock Style="{StaticResource Note}" Margin="122,-4,0,8" Text="Azure OpenAI / Live はリソースのルート URL"/>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ModelLabel" Style="{StaticResource FieldLabel}" Text="モデル"/>
                                    <TextBox x:Name="ModelBox" Grid.Column="1"/>
                                </Grid>
                                <TextBlock x:Name="ModelError" Style="{StaticResource FieldError}"/>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="言語"/>
                                    <TextBox x:Name="LanguageBox" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center" Text="例: ja。空欄で自動判定"/>
                                </Grid>
                                <TextBlock x:Name="LanguageError" Style="{StaticResource FieldError}"/>
                                <StackPanel x:Name="LiveCostForm" Visibility="Collapsed">
                                    <Grid Style="{StaticResource FieldRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="単価 (USD/分)"/>
                                        <TextBox x:Name="LiveRateBox" Grid.Column="1"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center" Text="空欄で未設定"/>
                                    </Grid>
                                    <TextBlock x:Name="LiveRateError" Style="{StaticResource FieldError}"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="122,-4,0,8"
                                               Text="Azure の契約・リージョンの単価を入力してください。送信済音声の時間から概算し、請求確定額とは異なります。"/>
                                </StackPanel>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="API キー"/>
                                    <PasswordBox x:Name="KeyBox" Grid.Column="1"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="122,-4,0,0">
                                    <TextBlock x:Name="KeyStateText" Style="{StaticResource Note}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Button Content="保存済みキーを削除" Style="{StaticResource LinkButton}" Click="OnDeleteKey"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Note}" FontSize="11" Margin="122,4,0,0"
                                           Text="API キーは Windows 資格情報マネージャーにのみ保存します。設定ファイルには書きません。"/>

                                <Border Height="1" Background="{DynamicResource Divider}" Margin="-16,14,-16,12"/>
                                <TextBlock x:Name="ActiveText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                                <TextBlock x:Name="SaveResultText" Style="{StaticResource OptionalNote}" Margin="0,-4,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="UseButton" Content="このプロファイルを使用する" Appearance="Primary" Click="OnUseProfile" Margin="0,0,8,0"/>
                                    <ui:Button Content="このプロファイルを削除" Appearance="Secondary" Click="OnDeleteProfile"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="プロファイルを追加"/>
                                <TextBlock Style="{StaticResource Note}" Text="使うサービスを選んで追加します。"/>
                                <WrapPanel x:Name="AddButtons" Margin="0,10,0,0">
                                    <ui:Button Content="Azure MAI を追加" Appearance="Secondary" Margin="0,0,8,6" Click="OnAddAzure"/>
                                    <ui:Button Content="Azure OpenAI を追加" Appearance="Secondary" Margin="0,0,8,6" Click="OnAddAzureOpenAi"/>
                                    <ui:Button Content="Azure OpenAI Live を追加" Appearance="Secondary" Margin="0,0,8,6" Click="OnAddAzureOpenAiLive"/>
                                    <ui:Button Content="OpenAI / 互換を追加" Appearance="Secondary" Margin="0,0,8,6" Click="OnAddOpenAi"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== マイク ======== -->
            <TabItem x:Name="MicrophoneTab" Header="マイク" Tag="{x:Static ui:SymbolRegular.Mic24}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,14">
                        <TextBlock Style="{StaticResource PageTitle}" Text="マイク" Margin="0,0,0,14"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="入力デバイス"/>
                                        <TextBlock Style="{StaticResource Note}" Text="録音に使うマイク。すべてのプロファイルに共通です"/>
                                    </StackPanel>
                                    <ComboBox x:Name="MicrophoneBox" Grid.Column="1" MinWidth="220" MaxWidth="300" Margin="12,0,0,0"
                                              VerticalAlignment="Center" SelectionChanged="OnMicrophoneSelected"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                           Text="Windows の既定を選ぶと、録音開始時の既定マイクを使います。Bluetooth ヘッドセットのハンズフリーマイクは、録音の開始時に音声接続の準備で時間がかかることがあります。開始音はマイクの準備ができてから鳴ります。"/>
                                <Button Content="接続済みマイクを再読み込み" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Click="OnRefreshMicrophones"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="入力テスト"/>
                                        <TextBlock Style="{StaticResource Note}" Text="話すとレベルが動きます"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="MicrophoneStartButton" Content="テストを開始" Appearance="Secondary" Margin="0,0,8,0" Click="OnBeginMicrophoneTest"/>
                                        <ui:Button x:Name="MicrophoneStopButton" Content="テストを停止" Appearance="Primary" IsEnabled="False" Click="OnStopMicrophoneTest"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <local:LevelMeter x:Name="MicrophoneLevel" Height="28" BarCount="48" BarWidth="3" Gap="3"
                                                      BarBrush="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MicrophoneDbText" Text="– dB" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="MicrophoneTestText" Style="{StaticResource Note}" Foreground="{DynamicResource TextBody}" Margin="0,10,0,0"/>
                                <TextBlock Style="{StaticResource Note}" Margin="0,6,0,0"
                                           Text="15 秒で止まります。音声は保存・送信せず、履歴にも残しません。入力テスト中は Ctrl + Win による本録音を開始できません。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== 履歴 ======== -->
            <TabItem x:Name="HistoryTab" Header="履歴" Tag="{x:Static ui:SymbolRegular.History24}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,14">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PageTitle}" Text="履歴"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Note}" Margin="12,0,0,4" VerticalAlignment="Bottom"
                                       Text="直近 20 件 · 文章のみ保存"/>
                            <Button Grid.Column="2" Content="すべて削除" Style="{StaticResource LinkButton}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                    Command="{Binding ClearAllCommand}"/>
                        </Grid>
                        <Border x:Name="HistoryCorruptBanner" Style="{StaticResource ErrorBanner}"
                                Visibility="{Binding IsCorrupt, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock x:Name="HistoryCorruptText" Text="{Binding CorruptMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorText}"/>
                                <ui:Button Content="破損ファイルを別名へ退避して初期化" Appearance="Secondary" Margin="0,8,0,0"
                                           Command="{Binding QuarantineCorruptFileCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <ListBox x:Name="HistoryList" Template="{StaticResource PlainList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Preview}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16,11">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBg}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBg}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Preview}" ToolTip="{Binding Full}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ProfileName}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="3" Content="コピー" Style="{StaticResource LinkButton}" Margin="12,0,0,0" Click="OnCopyHistoryRow"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="まだ履歴はありません" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,28">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=HistoryList}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Note}" Text="音声は保存しません。履歴の操作は保存を待たず、すぐ反映されます。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== 一般 ======== -->
            <TabItem x:Name="GeneralTab" Header="一般" Tag="{x:Static ui:SymbolRegular.Settings24}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,14">
                        <TextBlock Style="{StaticResource PageTitle}" Text="一般" Margin="0,0,0,14"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="サインイン時に起動"/>
                                    <TextBlock Style="{StaticResource Note}" Text="Windows にサインインしたらトレイに常駐します"/>
                                    <TextBlock x:Name="StartupResultText" Style="{StaticResource OptionalNote}" Foreground="{DynamicResource ErrorText}"/>
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="StartupBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                 AutomationProperties.Name="サインイン時に起動" Click="OnStartupClicked"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="テーマ"/>
                                    <TextBlock Style="{StaticResource Note}" Text="設定画面と状態表示の配色"/>
                                    <TextBlock x:Name="ThemeResultText" Style="{StaticResource OptionalNote}" Foreground="{DynamicResource ErrorText}"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="180" Margin="12,0,0,0" VerticalAlignment="Center"
                                          AutomationProperties.Name="テーマ" SelectionChanged="OnThemeSelected"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="直近の Live 利用"/>
                                <TextBlock Style="{StaticResource Note}" Text="概算。実際の請求は各サービスで確認してください。アプリを終了するまで保持します"/>
                                <TextBlock x:Name="LastLiveCostText" FontFamily="{StaticResource MonoFont}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="保存場所"/>
                                    <TextBlock x:Name="PathText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Content="フォルダーを開く" Appearance="Secondary" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Click="OnOpenDataFolder"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="更新"/>
                                    <TextBlock x:Name="UpdateText" Style="{StaticResource Note}"/>
                                </StackPanel>
                                <ui:Button x:Name="UpdateButton" Grid.Column="1" Content="再起動して更新" Appearance="Primary" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" Click="OnUpdateClicked"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== 使い方 ======== -->
            <TabItem x:Name="HelpTab" Header="使い方" Tag="{x:Static ui:SymbolRegular.Question24}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,24,14">
                        <TextBlock Style="{StaticResource PageTitle}" Text="使い方" Margin="0,0,0,14"/>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <ItemsControl x:Name="ShortcutList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="16,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" Foreground="{DynamicResource TextBody}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="貼り付け"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextBody}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="録音終了時に前面だったウィンドウが変わっていなければ貼り付けます。ウィンドウを移動した場合は貼り付けず、クリップボードへコピーして通知します。左右どちらの Ctrl / Win でも、押す順番はどちらでも使えます。"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="状態表示の見方"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextBody}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="22">
                                    <Run Foreground="{StaticResource Recording}" Text="● 赤(点滅)"/><Run Text=" 録音中(最大 5 分で自動停止。「取消」で録音を破棄。通常の接続先では音声を送信しません。Live では取消の前に送信済みの音声は取り消せません)"/><LineBreak/>
                                    <Run Foreground="{DynamicResource Accent}" Text="◌ 回転"/><Run Text=" 認識中(「中止」で通信を止め、音声を保持して再送待ちへ。Live では送信済みの音声は取り消せず、再送は全体を送り直します)"/><LineBreak/>
                                    <Run Foreground="{StaticResource Warning}" Text="! 橙"/><Run Text=" 失敗・再送待ち(音声はメモリに保持。「再送」か「破棄」するまで新しい録音はできません)"/><LineBreak/>
                                    <Run Foreground="{StaticResource Caution}" Text="! 黄"/><Run Text=" コピーのみ(貼り付けず、クリップボードにだけ入れた)"/><LineBreak/>
                                    <Run Foreground="{StaticResource Success}" Text="✓ 緑"/><Run Text=" 貼り付け完了"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
