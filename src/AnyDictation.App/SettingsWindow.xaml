<Window x:Class="AnyDictation.App.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Any Dictation 設定" Width="760" Height="580" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs" Grid.Row="0" Margin="8,8,8,4">
            <TabItem x:Name="ProfileTab" Header="プロファイル">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="SettingsCorruptBanner" Grid.Row="0" Visibility="Collapsed" Background="#FFFDECEA"
                            BorderBrush="#FFD32F2F" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="SettingsCorruptText" TextWrapping="Wrap" Foreground="#FFB71C1C"/>
                            <Button Content="破損ファイルを別名へ退避して初期化" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                                    Click="OnQuarantineSettings"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock DockPanel.Dock="Top" Text="● は保存後に使用するプロファイルです。" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="Azure MAI を追加" Padding="6,3" Margin="0,0,0,4" Click="OnAddAzure"/>
                                <Button Content="Azure OpenAI を追加" Padding="6,3" Margin="0,0,0,4" Click="OnAddAzureOpenAi"/>
                                <Button Content="Azure OpenAI Live を追加" Padding="6,3" Margin="0,0,0,4" Click="OnAddAzureOpenAiLive"/>
                                <Button Content="OpenAI / 互換を追加" Padding="6,3" Margin="0,0,0,14" Click="OnAddOpenAi"/>
                                <Button Content="選択中のプロファイルを削除" Padding="6,3" Click="OnDeleteProfile"/>
                            </StackPanel>
                            <ListBox x:Name="ProfileList" MinHeight="60" SelectionChanged="OnProfileSelected"/>
                        </DockPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="Form" IsEnabled="False" Margin="0,0,6,0">
                                <GroupBox Header="使用" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="ActiveText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Button x:Name="UseButton" Content="このプロファイルを使用する" HorizontalAlignment="Left" Padding="10,3" Click="OnUseProfile"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="接続" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="名前"/>
                                        <TextBox x:Name="NameBox" Margin="0,2,0,8" TextChanged="OnFormEdited"/>
                                        <TextBlock Text="サービス"/>
                                        <ComboBox x:Name="ProviderBox" Margin="0,2,0,2" SelectionChanged="OnProviderChanged"/>
                                        <TextBlock x:Name="LiveNote" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FFB26A00" Margin="0,2,0,8"
                                                   Text="Live は録音中から音声を送信し、途中の文字を状態表示に出します。取消・中止・失敗の前に送信済みの音声は取り消せません。失敗後の再送は全体を送り直すため追加課金されます。音声は 24 kHz で録音します。"/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run Text="エンドポイント"/><Run Foreground="Gray" Text="  Azure OpenAI / Live はリソースのルート URL"/></TextBlock>
                                        <Grid Margin="0,2,0,8">
                                            <TextBox x:Name="EndpointBox" TextChanged="OnEndpointEdited"/>
                                            <TextBlock x:Name="EndpointPlaceholder" IsHitTestVisible="False" Foreground="Gray" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap"><Run Text="モデル"/><Run Foreground="Gray" Text="  Azure OpenAI / Live はデプロイ名"/></TextBlock>
                                        <TextBox x:Name="ModelBox" Margin="0,2,0,8" TextChanged="OnFormEdited"/>
                                        <TextBlock TextWrapping="Wrap"><Run Text="言語コード"/><Run Foreground="Gray" Text="  例: ja。空欄で自動判定"/></TextBlock>
                                        <TextBox x:Name="LanguageBox" Margin="0,2,0,0" TextChanged="OnFormEdited"/>
                                        <StackPanel x:Name="LiveCostForm" Visibility="Collapsed" Margin="0,8,0,0">
                                            <TextBlock TextWrapping="Wrap"><Run Text="Live の単価（USD/分）"/><Run Foreground="Gray" Text="  空欄で未設定"/></TextBlock>
                                            <TextBox x:Name="LiveRateBox" Margin="0,2,0,2" TextChanged="OnFormEdited"/>
                                            <TextBlock Text="Azure の契約・リージョンの単価を入力してください。送信済音声の時間から概算し、請求確定額とは異なります。" TextWrapping="Wrap" Foreground="Gray"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="API キー" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap"><Run Text="キーを入力"/><Run Foreground="Gray" Text="  Windows 資格情報マネージャーへ保存。設定ファイルには書きません"/></TextBlock>
                                        <PasswordBox x:Name="KeyBox" Margin="0,2,0,2" PasswordChanged="OnFormEdited"/>
                                        <TextBlock x:Name="KeyStateText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Button Content="保存済みキーを削除" HorizontalAlignment="Left" Padding="8,2" Click="OnDeleteKey"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="MicrophoneTab" Header="マイク">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="音声入力に使うマイク" FontWeight="Bold"/>
                        <TextBlock Text="すべての接続先に共通です。Windows の既定を選ぶと、録音開始時の既定マイクを使います。" TextWrapping="Wrap" Margin="0,6,0,8"/>
                        <ComboBox x:Name="MicrophoneBox" SelectionChanged="OnMicrophoneSelected" Margin="0,0,0,8"/>
                        <Button Content="接続済みマイクを再読み込み" Click="OnRefreshMicrophones" HorizontalAlignment="Left" Padding="10,4"/>
                        <TextBlock Text="入力テスト" FontWeight="Bold" Margin="0,16,0,6"/>
                        <TextBlock Text="未保存の選択も試せます。話しかけると音量と入力状態を表示し、15 秒で止まります。音声は保存・送信せず、履歴にも残しません。入力テスト中は Ctrl + Win による本録音を開始できません。" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ProgressBar x:Name="MicrophoneLevel" Minimum="0" Maximum="100" Height="16"/>
                        <TextBlock x:Name="MicrophoneTestText" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MicrophoneStartButton" Content="入力テストを開始" Click="OnBeginMicrophoneTest" Padding="10,4" Margin="0,0,8,0"/>
                            <Button x:Name="MicrophoneStopButton" Content="停止" Click="OnStopMicrophoneTest" IsEnabled="False" Padding="10,4"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="履歴">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="HistoryCorruptBanner" Visibility="Collapsed" Background="#FFFDECEA"
                            BorderBrush="#FFD32F2F" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="HistoryCorruptText" TextWrapping="Wrap" Foreground="#FFB71C1C"/>
                            <Button Content="破損ファイルを別名へ退避して初期化" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3"
                                    Click="OnQuarantineHistory"/>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="HistoryList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="日時" Width="140" DisplayMemberBinding="{Binding TimeText}"/>
                                <GridViewColumn Header="プロファイル" Width="110" DisplayMemberBinding="{Binding ProfileName}"/>
                                <GridViewColumn Header="認識結果" Width="420" DisplayMemberBinding="{Binding Preview}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="選択した履歴をコピー" Padding="10,3" Margin="0,0,8,0" Click="OnCopyHistory"/>
                        <Button Content="履歴をすべて削除" Padding="10,3" Margin="0,0,12,0" Click="OnClearHistory"/>
                        <TextBlock Text="直近 20 件の文章のみ保存します(音声は保存しません)。履歴の操作は保存を待たず、すぐ反映されます。" VerticalAlignment="Center" Foreground="Gray"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="GeneralTab" Header="一般">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="起動" FontWeight="Bold" Margin="0,0,0,4"/>
                        <CheckBox x:Name="StartupBox" Content="Windows にサインインしたとき自動起動する" Click="OnStartupClicked"/>
                        <TextBlock Text="チェックを切り替えた時点で Windows へ反映します。「保存」は不要です。" Foreground="Gray" TextWrapping="Wrap" Margin="20,2,0,0"/>
                        <TextBlock x:Name="StartupResultText" Foreground="#FFB71C1C" TextWrapping="Wrap" Margin="20,2,0,0"/>
                        <TextBlock Text="直近の Live 利用（アプリを終了するまで保持）" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBlock x:Name="LastLiveCostText" TextWrapping="Wrap"/>
                        <TextBlock Text="保存場所" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBlock x:Name="PathText" TextWrapping="Wrap"/>
                        <Button Content="フォルダを開く" HorizontalAlignment="Left" Padding="10,3" Margin="0,6,0,0" Click="OnOpenDataFolder"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="HelpTab" Header="使い方">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="操作" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Text="Ctrl キーと Windows キーを同時に押して離すと録音を開始します。もう一度同じ操作をすると停止して文字起こしし、録音終了時に前面だったウィンドウが変わっていなければ貼り付けます(Enter は送信しません)。ウィンドウを移動した場合は貼り付けず、クリップボードへコピーして通知します。左右どちらの Ctrl / Win でも、押す順番はどちらでも使えます。"/>
                        <TextBlock Text="状態表示の見方" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBlock TextWrapping="Wrap">
                            <Run Foreground="#FFE53935" Text="● 赤"/><Run Text=" 録音中(最大 5 分で自動停止。「取消」で録音を破棄。通常の接続先では音声を送信しません。Live では取消の前に送信済みの音声は取り消せません)"/><LineBreak/>
                            <Run Foreground="#FFFB8C00" Text="● 橙"/><Run Text=" 認識中(「中止」で通信を止め、音声を保持して再送待ちへ。Live では送信済みの音声は取り消せず、再送は全体を送り直します)"/><LineBreak/>
                            <Run Foreground="#FFD32F2F" Text="● 濃赤"/><Run Text=" 失敗・再送待ち(音声はメモリに保持。「再送」か「破棄」するまで新しい録音はできません)"/><LineBreak/>
                            <Run Foreground="#FFB8A000" Text="● 黄"/><Run Text=" コピーのみ(貼り付けず、クリップボードにだけ入れた)"/><LineBreak/>
                            <Run Foreground="#FF43A047" Text="● 緑"/><Run Text=" 貼り付け完了"/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="1" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="DirtyText" Visibility="Collapsed" Text="未保存の変更があります" FontWeight="Bold" Foreground="#FFB26A00"/>
                <TextBlock x:Name="SaveResultText" TextWrapping="Wrap"/>
                <TextBlock Text="プロファイルとマイクは「保存」で反映します。閉じると未保存の変更は破棄されます。" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="SaveButton" Grid.Column="1" Content="保存" Padding="20,4" VerticalAlignment="Center" Click="OnSave"/>
        </Grid>
    </Grid>
</Window>
