<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AnyDictation.App</RootNamespace>
    <AssemblyName>AnyDictation</AssemblyName>
    <Product>Any Dictation</Product>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- リリース区分。true はプレビュー版で、GitHub の Pre-release として公開し、更新では Pre-release と安定版を取得する。
         false は安定版で、安定版として公開し、安定版だけを取得する。release.yml も公開時にこの値を読む -->
    <PreviewRelease>true</PreviewRelease>
    <!-- release.yml もこの値を読み、同じ版の vpk を使う -->
    <VelopackVersion>1.2.161</VelopackVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PreviewRelease" Value="$(PreviewRelease)" />
    <InternalsVisibleTo Include="AnyDictation.E2E" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269" PrivateAssets="all" />
    <PackageReference Include="Velopack" Version="$(VelopackVersion)" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <ProjectReference Include="..\AnyDictation.Core\AnyDictation.Core.csproj" />
    <PackageReference Include="NAudio.WinMM" Version="3.1.0" />
  </ItemGroup>
</Project>
